<div class="row">
  <div class="col-sm-4 offset-sm-4">
    <h1>Confirm purchase</h1>
    <p>Scanned code: <strong id="scanned-code"></strong></p>
    <p>Confirm purchase?</p>
    <%= link_to "Sim", pin_path, class: "btn btn-primary" %>
    <%= link_to "Não", home_path, class: "btn btn-danger" %>
  </div>
</div>

<script>
  (function () {
    // textContent treats the scanned value as plain text, so a malicious QR code cannot inject markup.
    var code = sessionStorage.getItem("cont");
    document.getElementById("scanned-code").textContent = code || "(nothing scanned)";
  })();
</script>
